{
  "name": "website",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "test": "echo \"Error: no test specified\" && exit 1",
    "watch:pug2html": "chokidar \"src/pug/\" -c \"npm run compile:pug2html\" --initial",
    "start:server": "browser-sync start -s dist -w src/*.html src/css/*.css src/js/*.js",
    "compile:css2cssprefix": "postcss dist/css/style.css -u autoprefixer -o dist/css/style.css",
    "compile:scss2css": "sass src/scss/style.scss:dist/css/style.css --style=expanded --source-map-urls=relative",
    "compile:scss2cssprefix": "run-s compile:scss2css compile:css2cssprefix",
    "watch:scss2cssprefix": "chokidar \"src/scss/\" --command \"npm run compile:scss2cssprefix\" --initial",
    "watch:ts": "tsc --rootDir src/ts --outDir dist/js --watch",
    "watch:img": "chokidar \"src/img/**/*\" -c \"node imagemin.mjs\" --initial",
    "delete:dist": "rimraf dist",
    "prewatch:all": "run-s delete:dist make:cname",
    "watch:all": "run-p watch:pug2html watch:scss2cssprefix watch:ts watch:img start:server",
    "lint:scss": "stylelint \"**/*.scss\"",
    "format:scss": "stylelint --fix \"**/*.scss\"",
    "lint:ts": "eslint src/ts/**/*.ts",
    "format:ts": "eslint src/ts/**/*.ts --fix",
    "format:all": "run-p format:scss format:ts",
    "min:css": "cleancss -o dist/css/style.css dist/css/style.css",
    "min:js": "terser dist/js/main.js -c -m -o dist/js/main.js",
    "delete:map": "rimraf dist/**/*.map",
    "prepare:all": "run-p min:js min:css delete:map",
    "make:cname": "node cname.js",
    "compile:pug2html": "node build-pug.js"
  },
  "keywords": [],
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "autoprefixer": "^10.5.4",
    "browser-sync": "^3.0.4",
    "chokidar-cli": "^3.0.0",
    "clean-css-cli": "^5.6.3",
    "eslint": "^10.9.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.6",
    "imagemin": "^9.0.1",
    "imagemin-gifsicle": "^7.0.0",
    "imagemin-mozjpeg": "^10.0.0",
    "imagemin-pngquant": "^10.0.0",
    "imagemin-svgo": "^12.0.0",
    "npm-run-all": "^4.1.5",
    "postcss": "^8.5.27",
    "postcss-cli": "^11.0.1",
    "prettier": "^3.9.6",
    "pug": "^3.0.4",
    "rimraf": "^6.1.3",
    "sass": "^1.59.3",
    "stylelint": "^17.14.1",
    "stylelint-config-recommended-scss": "^17.0.1",
    "stylelint-order": "^8.1.1",
    "stylelint-prettier": "^5.0.3",
    "stylelint-scss": "^7.2.0",
    "terser": "^5.51.2",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.69.0"
  },
  "allowScripts": {
    "gifsicle@5.3.0": true,
    "mozjpeg@8.0.0": true,
    "pngquant-bin@9.0.0": true,
    "@parcel/watcher@2.6.0": true
  }
}

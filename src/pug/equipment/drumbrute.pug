- var pagename='drumbrute|spindey.com'
- var description='ArturiaのDrumbruteのマニュアルです。'
- var keywords='brumbrute,arturia'
doctype html
html(lang="ja")
  include ../_include/_head.pug
  body
    h1.heading drumbrute
    main
      h2.heading.switch
        | 音色
        span.swithCondition.contentClosed
      section.h2content.hide
        h3.heading.switch
          | 音色の選択
          span.swithCondition.contentClosed
        section.h3content.hide
          p
            | ポーズ中
            br
            | パッドをタップする
            br
            | パッドが点灯している場合、インストゥルメントが選択されていることを意味する
          p
            | レコーディング中
            br
            | レコーディング中にノートを入力せずにインストゥルメントを選択するには、
            span.controllerButton Shift
            | を押しながら任意のパッドをタップ
        h3.heading.switch
          | 音色
          span.swithCondition.contentClosed
        section.h3content.hide
          .tableScroll
            table
              tr
                td kick1
                td
                  span.controllerKnob Level
                  span.controllerKnob Pitch
                  span.controllerKnob Decay
                  span.controllerKnob Impact
                  span.controllerKnob Sweep
              tr
                td kick2
                td
                  span.controllerKnob Level
                  span.controllerKnob Pitch
                  span.controllerKnob Decay
              tr
                td snare
                td
                  span.controllerKnob Level
                  span.controllerKnob Snap Level
                  span.controllerKnob Snap Decay
                  span.controllerKnob Snap Tone
                  span.controllerKnob Drum Tone
              tr
                td clap
                td
                  span.controllerKnob Level
                  span.controllerKnob Tone
                  span.controllerKnob Decay
              tr
                td Rimshot/Clave
                td
                  span.controllerKnob Level
                  span.controllerKnob Rim Tone
              tr
                td Closed Hat
                td
                  span.controllerKnob Level
                  span.controllerKnob Pitch
                  span.controllerKnob Decay
              tr
                td Open Hat
                td
                  span.controllerKnob Level
                  span.controllerKnob Pitch
                  span.controllerKnob Decay
              tr
                td Tom Hi/Conga Hi
                td
                  span.controllerKnob Level
                  span.controllerKnob Pitch
              tr
                td Tom Low/Conga Low
                td
                  span.controllerKnob Level
                  span.controllerKnob Pitch
              tr
                td Cymbal/Reverse Cymbal
                td
                  span.controllerKnob Level
                  span.controllerKnob Tone
                  span.controllerKnob Decay
              tr
                td Maracas/Tamb
                td
                  span.controllerKnob Level
                  span.controllerKnob Tamb Decay
              tr
                td Zap
                td
                  span.controllerKnob Level
                  span.controllerKnob Pitch
                  span.controllerKnob Decay
      h2.heading.switch
        | 音量
        span.swithCondition.contentClosed
      section.h2content.hide
        h3.heading.switch
          | マスター・ボリューム
          span.swithCondition.contentClosed
        section.h3content.hide
          p マスターアウト・レベルをコントロールする
          .contentOperationBox
            p.contentOperationCaption 操作
            ul.contentOperationOrderlistGroup
              li.contentOperationOrderlist
                span.controllerKnob Master Volume
                | を回す
          p ヘッドフォン・レベルには影響しない
        h3.heading.switch
          | トラック・ボリューム
          span.swithCondition.contentClosed
        section.h3content.hide
          p 各トラックのアウト・レベルをコントロールする
          .contentOperationBox
            p.contentOperationCaption 操作
            ul.contentOperationOrderlistGroup
              li.contentOperationOrderlist
                | 各インストゥルメントの
                span.controllerKnob Level
                | を回す
        h3.heading.switch
          | ヘッドフォン・ボリューム
          span.swithCondition.contentClosed
        section.h3content.hide
          p ヘッドフォンのアウト・レベルをコントロールする
          .contentOperationBox
            p.contentOperationCaption 操作
            ul.contentOperationOrderlistGroup
              li.contentOperationOrderlist
                span.controllerKnob Volume(リアパネル)
      h2.heading.switch
        | テンポ
        span.swithCondition.contentClosed
      section.h2content.hide
        h3.heading.switch
          | テンポの設定
          span.swithCondition.contentClosed
        section.h3content.hide
          p テンポはパターンごとに保存されるので、ソング内でも異なるテンポを含むことができる
          table
            tr
              td 調整
              td
                span.controllerKnob Rate/Fine
                br
                | 範囲は、30~300BPM(シンクがインターナルの場合)
            tr
              td 微調整
              td
                span.controllerButton Shift
                | を押しながら
                span.controllerKnob Rate/Fine
                | を時計回りに回す
                br
                | 範囲は.00~.99
                br
                | 微調整した値をリセットしたい場合、
                span.controllerButton Shift
                | を押さずに
                span.controllerKnob Rate/Fine
                | を回す
        h3.heading.switch
          | グローバル BPM
          span.swithCondition.contentClosed
        section.h3content.hide
          p すべてのパターンを同じテンポで演奏させる
          .contentOperationBox
            p.contentOperationCaption 操作
            ul.contentOperationOrderlistGroup
              li.contentOperationOrderlist
                span.controllerButton Shift
                | を押しながら
                span.controllerButton 15
                | を押す
        h3.heading.switch
          | タップテンポ
          span.swithCondition.contentClosed
        section.h3content.hide
          .contentOperationBox
            p.contentOperationCaption 操作
            ul.contentOperationOrderlistGroup
              li.contentOperationOrderlist
                | 希望するテンポで
                span.controllerButton Tap Tempo
                | を複数回タップする
      h2.heading.switch
        | メトロノーム
        span.swithCondition.contentClosed
      section.h2content.hide
        h3.heading.switch
          | メトロノームをオン
          span.swithCondition.contentClosed
        section.h3content.hide
          .contentOperationBox
            p.contentOperationCaption 操作
            ul.contentOperationOrderlistGroup
              li.contentOperationOrderlist
                span.controllerButton On
                | を押す
          table
            tr
              td 出力レベル
              td
                span.controllerKnob Metro Volume
            tr
              td タイミング
              td
                span.controllerButton On
                | を押しながら1/8~1/32の値を選択
                br
                |                    [選択したボタンが青色に点灯]
                br
                |                     タイミング値ボタンが点灯している間は、選択解除を行なうことも可能
      h2.heading.switch
        | バンク
        span.swithCondition.contentClosed
      section.h2content.hide
        h3.heading.switch
          | バンクの選択
          span.swithCondition.contentClosed
        section.h3content.hide
          .contentOperationBox
            p.contentOperationCaption 操作
            ul.contentOperationOrderlistGroup
              li.contentOperationOrderlist
                span.controllerButton Bank
                | を押す
              li.contentOperationOrderlist
                span.controllerButton A
                | 、
                span.controllerButton B
                | 、
                span.controllerButton C
                | 、
                span.controllerButton D
                | のいずれかを押す
        h3.heading.switch
          | パターンのバンクの保存
          span.swithCondition.contentClosed
        section.h3content.hide
          .contentOperationBox
            p.contentOperationCaption 操作
            ul.contentOperationOrderlistGroup
              li.contentOperationOrderlist
                span.controllerButton Save
                | を押しながら
                span.controllerButton Bank
                | を押す
        h3.heading.switch
          | バンクの消去
          span.swithCondition.contentClosed
        section.h3content.hide
          p バンク内の16パターンすべてを消去
          .contentOperationBox
            p.contentOperationCaption 操作
            ul.contentOperationOrderlistGroup
              li.contentOperationOrderlist
                span.controllerButton Erase
                | を押す
              li.contentOperationOrderlist
                span.controllerButton Bank
                | を押す
                br
                | [選択されているバンクのステップ・ボタンが点滅]
              li.contentOperationOrderlist
                span.controllerButton A
                |  or
                span.controllerButton B
                |  or
                span.controllerButton C
                |  or
                span.controllerButton D
                | で消去したいバンクを選択
        h3.heading.switch
          | バンクのコピー
          span.swithCondition.contentClosed
        section.h3content.hide
          p 別のバンクに16個のパターンすべてをコピー
          .contentOperationBox
            p.contentOperationCaption 操作
            ul.contentOperationOrderlistGroup
              li.contentOperationOrderlist コピー元のバンクのステップ・ボタンを押して選択
              li.contentOperationOrderlist
                span.controllerButton Copy
                | を押す
              li.contentOperationOrderlist
                span.controllerButton Bank
                | をもう一度押す
              li.contentOperationOrderlist コピー先のバンクのステップ・ボタンを選択
      h2.heading.switch
        | パターン
        span.swithCondition.contentClosed
      section.h2content.hide
        h3.heading.switch
          | パターンとは
          span.swithCondition.contentClosed
        section.h3content.hide
          p DrumBruteは、16パターンを4つのバンク、合計64パターンを使用することができる
          p パターンのデフォルトの長さは16ステップだが、最長で64ステップまでの長さを設定可能
        h3.heading.switch
          | スポット・イレース
          span.swithCondition.contentClosed
        section.h3content.hide
          p レコード・モードでパターンがループしている間、ノートを消去する
          .contentOperationBox
            p.contentOperationCaption 操作
            ul.contentOperationOrderlistGroup
              li.contentOperationOrderlist
                span.controllerButton Erase
                | を押したまま消去したい音が発音される時にそのパッドをタップ
        h3.heading.switch
          | ステップ入力
          span.swithCondition.contentClosed
        section.h3content.hide
          p
            | ステップ・ボタンを押す
            br
            br
            |  点灯しているステップ・ボタンには、イベントが含まれているが、暗いボタンにはイベントが含まれない
            br
            |  必要に応じてステップ・ボタンを使用してイベントのオン/オフを切替える
            br
            |  ステップ・モードでオフからオンに切り替えるとイベントは常に青色に点灯する
          p ボタンの点灯色
          table
            tr
              td 消灯
              td イベント無
            tr
              td 青色
              td イベント有
            tr
              td 赤色
              td アクセント付
          p
            | インストゥルメント・トラック内の特定のステップのベロシティを素早く増やす
            br
            |  赤色に点灯したステップ・ボタンは、そのステップにアクセント・イベントが発生していることを示す
          p
            | ステップ・ボタンを使用してアクセント・イベントを入力する
            br
            |  アクセント・モードでオフからオンに切り替えるとイベントは赤く点灯する
            br
            |  青色のイベントは、そのステップにイベントがすでに存在しているが、アクセントになっていないことを示す
        h3.heading.switch
          | ステップ・リピート
          span.swithCondition.contentClosed
        section.h3content.hide
          .contentOperationBox
            p.contentOperationCaption 操作
            ul.contentOperationOrderlistGroup
              li.contentOperationOrderlist 各ビートに簡単なパターンを作成し、それをループさせる
              li.contentOperationOrderlist
                | ステップ・モードに入り、インストゥルメントを選択(
                span.controllerButton Shift
                | + インストゥルメント)
              li.contentOperationOrderlist
                | 点灯しているステップ・ボタンの1つを押し続ける
                br
                | [白いLEDはローラー/ルーパー ・ストリップの下でデフォルト値1で点灯]
              li.contentOperationOrderlist
                | ステップ・ボタンを押しながらストリップに沿って指をスライドさせ2の値を選択
                br
                | [パターンがそのポイントに次回達するとキックドラムが1ステップの間に2回鳴る]
          p ステップ・リピート機能は、レコード・モードでのみ使用可能
        h3.heading.switch
          | シフト・タイミング
          span.swithCondition.contentClosed
        section.h3content.hide
          .contentOperationBox
            p.contentOperationCaption 操作
            ul.contentOperationOrderlistGroup
              li.contentOperationOrderlist ステップ・モードに入る
              li.contentOperationOrderlist
                | インストゥルメントを選択(
                span.controllerButton Shift
                | +インストゥルメント)
              li.contentOperationOrderlist
                | ステップ・ボタンを押しながら
                span.controllerKnob Swing
                | を回す
            table
              tr
                td 反時計回り
                td ディスプレイに-1~ -50までの負の数値が表示される
              tr
                td 時計回り
                td ディスプレイには1~50の正の数値表示される
          p
            | 現在のインストゥルメントのすべてのステップをシフト
            br
            span.controllerButton Shift
            | +
            span.controllerKnob Swing
            br
            |  常にシフト値0から始まる
            br
            span.controllerButton Shift
            | +
            span.controllerKnob Swing
            | オプションは、クオンタイズされていないインストゥルメント全体のデータを簡単にクオンタイズするオプション
        h3.heading.switch
          | パターンの保存
          span.swithCondition.contentClosed
        section.h3content.hide
          .contentOperationBox
            p.contentOperationCaption 操作
            ul.contentOperationOrderlistGroup
              li.contentOperationOrderlist
                span.controllerButton Save
                | を押しながら
                span.controllerButton Ptrn
                | を押す
          p
            | バンクを切り替えると、元のバンク内のパターンに行ったエディット内容は失われる
            br
            |  これはソング・モードに切り替えると発生する
        h3.heading.switch
          | パターンの選択
          span.swithCondition.contentClosed
        section.h3content.hide
          p
            | 選択中のバンク内のパターンを選択
            br
            | 1~16のステップボタンを押す
          p
            | バンクモードになっている場合は、まず
            span.controllerButton Ptrn
            | を押してからパターンを選択する
          p
            | パターンの切り替わり方は2種類(
            span.controllerButton Shift
            | +
            span.controllerButton 14
            | で指定可能)
            br
            | ※録音中はパターン変更できない
          table
            tr
              td 1
              td 選択された瞬間にパターン変更
            tr
              td 2
              td パターンの最終ステップまでプレーしてから変更
        h3.heading.switch
          | パターンのレコーディング
          span.swithCondition.contentClosed
        section.h3content.hide
          .contentOperationBox
            p.contentOperationCaption 操作
            ul.contentOperationOrderlistGroup
              li.contentOperationOrderlist
                | 空のパターンを選択し、レコード・ボタンを押してから再生ボタンを押す
                br
                | タップテンポ・ボタンが(メトロノーム・タイミング値に従って)点滅し始め、ステップ・ボタンはパターンの現在の位置を示すために1度に1つずつ紫色に変わる
              li.contentOperationOrderlist
                | パッドを演奏する
                br
                |                         DrumBruteがパターン内のそのポイントを再び通過すると、前回追加したものが聴こえる
              li.contentOperationOrderlist レコード・モードを終了するにはレコードを押す
          p ステップボタンを使用して、ステップ・モードで個々のイベントのオン/オフを切り替えることができる
        h3.heading.switch
          | パターンの消去
          span.swithCondition.contentClosed
        section.h3content.hide
          p バンク内のパターンの1つを消去
          .contentOperationBox
            p.contentOperationCaption 操作
            ul.contentOperationOrderlistGroup
              li.contentOperationOrderlist
                span.controllerButton Erase
                | を押す
              li.contentOperationOrderlist
                span.controllerButton Ptrn
                | を押す
                br
                | [選択されているパターンのステップ・ボタンが点滅]
              li.contentOperationOrderlist 「ステップ・ボタン」で消去したいパターンを選択
      h2.heading.switch
        | パターン(設定)
        span.swithCondition.contentClosed
      section.h2content.hide
        h3.heading.switch
          | クオンタイズ
          span.swithCondition.contentClosed
        section.h3content.hide
          p  オンのとき、リアルタイムでレコーディングした場合、選択したタイムディビジョンに従ってノートがクオンタイズされる
          .contentOperationBox
            p.contentOperationCaption 操作
            ul.contentOperationOrderlistGroup
              li.contentOperationOrderlist
                span.controllerButton Shift
                | と
                span.controllerButton ●
                | を同時に押すとオン/オフの切り替え
        h3.heading.switch
          | タイムディビジョン
          span.swithCondition.contentClosed
        section.h3content.hide
          p  再生レートの設定
          table
            tr
              th 音符
              th 操作
              th 表記
            tr
              td 8分音符
              td
                span.controllerButton Shift
                | を押しながら
                span.controllerButton 1
              td 1/8
            tr
              td 8分音符三連
              td
                span.controllerButton Shift
                | を押しながら
                span.controllerButton 2
              td 1/8T
            tr
              td 16分音符[デフォルト]
              td
                span.controllerButton Shift
                | を押しながら
                span.controllerButton 3
              td 1/16
            tr
              td 16分音符三連
              td
                span.controllerButton Shift
                | を押しながら
                span.controllerButton 4
              td 1/16T
            tr
              td 32分音符
              td
                span.controllerButton Shift
                | を押しながら
                span.controllerButton 5
              td 1/32
        h3.heading.switch
          | パターンフォロー・モード
          span.swithCondition.contentClosed
        section.h3content.hide
          p 再生中にこのモードがオンになっていると、ステップ・グループのLEDが再生位置を追従する
          .contentOperationBox
            p.contentOperationCaption 操作
            ul.contentOperationOrderlistGroup
              li.contentOperationOrderlist
                span.controllerButton «
                | と
                span.controllerButton »
                | を同時に押すとオン/オフの切り替え
        h3.heading.switch
          | パターン・レングスを調整する
          span.swithCondition.contentClosed
        section.h3content.hide
          .contentOperationBox
            p.contentOperationCaption 操作
            ul.contentOperationOrderlistGroup
              li.contentOperationOrderlist
                span.controllerButton Last Step
                | を押し続ける
              li.contentOperationOrderlist
                span.controllerButton <<
                |  or
                span.controllerButton >>
                | を押す[白いLEDが移動する]
              li.contentOperationOrderlist 希望するステップに対応するステップ・ボタンを押す
              li.contentOperationOrderlist
                span.controllerButton Last Step
                | を離す
          p ステップ・グループのLEDは16ステップごとに変わる
          table
            tr
              td ステップ
              td #16以上
              td #32以上
            tr
              td ステップ1~16
              td 赤いLED
              td 白いLED
            tr
              td ステップ17~32
              td 暗いLED
              td ピンク(白+赤)のLED
          p
            | 赤いLEDは、パターン内の現在のステップ・グループを示す
            br
            |  白いLEDはパターンの
            span.controllerButton Last Step
            | がそのステップ・グループにあることを意味する
      h2.heading.switch
        | パターン(コピー)
        span.swithCondition.contentClosed
      section.h2content.hide
        h3.heading.switch
          | パターンの拡張(コピーして追加)
          span.swithCondition.contentClosed
        section.h3content.hide
          p  パターン・データを最大16ステップまでコピーして、既存のパターンの最後に貼り付ける
          p
            span.controllerButton Shift
            | を押しながら
            span.controllerButton >>
            | を押す
          table
            tr
              td パターンに16以上のステップがある場合
              td 最初の16ステップだけがコピーされ、最後に追加される
            tr
              td パターンが16ステップより短い場合
              td 全てのステップ数がコピーされ、シーケンスの長さは2倍になる
          p  最大で64ステップまで拡張可能
        h3.heading.switch
          | パターンコピー(パターン内)
          span.swithCondition.contentClosed
        section.h3content.hide
          .contentOperationBox
            p.contentOperationCaption 操作
            ul.contentOperationOrderlistGroup
              li.contentOperationOrderlist
                span.controllerButton Copy
                | を押す
                br
                | [
                span.controllerButton Bank
                | と
                span.controllerButton Ptrn
                | 、そしてすべてのパッドが点滅する]
              li.contentOperationOrderlist コピー元のパッドを押す
              li.contentOperationOrderlist  コピー先のパッドを押す
        h3.heading.switch
          | パターンコピー(バンク内)
          span.swithCondition.contentClosed
        section.h3content.hide
          .contentOperationBox
            p.contentOperationCaption 操作
            ul.contentOperationOrderlistGroup
              li.contentOperationOrderlist
                span.controllerButton Ptrn
                | を押してパターンモードを選択
              li.contentOperationOrderlist コピー元のパターンのステップ・ボタンを押して選択
              li.contentOperationOrderlist
                span.controllerButton Copy
                | を押す
              li.contentOperationOrderlist
                span.controllerButton Ptrn
                | を押す
              li.contentOperationOrderlist コピー先のパターンのステップ・ボタンを押す
        h3.heading.switch
          | パターンコピー(バンク間)
          span.swithCondition.contentClosed
        section.h3content.hide
          p
            | バンクから別のバンクに1つのパターンをコピー可能
            br
            |  例：バンクAのパターン#7をバンクBのパターン#15にコピーする場合
          .contentOperationBox
            p.contentOperationCaption 操作
            ul.contentOperationOrderlistGroup
              li.contentOperationOrderlist バンクAのパターン#7を選択
              li.contentOperationOrderlist
                span.controllerButton Copy
                | を押す
              li.contentOperationOrderlist
                span.controllerButton Ptrn
                | を押す
              li.contentOperationOrderlist
                span.controllerButton Bank
                | を押す
              li.contentOperationOrderlist
                span.controllerButton B
                | を押す
              li.contentOperationOrderlist
                span.controllerButton Ptrn
                | を押す
              li.contentOperationOrderlist
                span.controllerButton 15
                | を押す
                br
                | [約1秒間点滅し、プロセスが完了]
      h2.heading.switch

- var pagename='TD-3|spindey.com'
- var description='Behringer TD-3のマニュアルです。'
- var keywords='TD-3,Behringer'
include ../_include/_section.pug
doctype html
html(lang="ja")
  include ../_include/_head.pug
  body
    h1.heading TD-3
    main.equipmentMain



      +section2("コントローラー")

        +section3("シンセサイザー部")
          .tableScroll
            table
              tr
                td TUNE
                td 内蔵VCOオシレーターの周波数を、中央から約1オクターブの範囲で調節
              tr
                td CUTOFF
                td ローパス VCF フィルターのカットオフ周波数を調節
                  br
                  | カットオフから上の周波数を減衰
              tr
                td RESONANCE
                td カットオフ周波数周辺の信号レベルを強調する度合いを調節
              tr
                td ENVELOPE
                td エンベロープジェネレーターにより VCF カットオフ周波数に適用される、モジュレーションの深さを選択

              tr
                td DECAY
                td エンベロープが、現在のレベルから最小まで減衰するのにかかる時間の長さを制御
              tr
                td ACCENT
                td アクセントをプログラムしたノートの出力に対する、アクセントの量を調節

              tr
                td FILTER IN
                td フィルター入力(外部オーディオ信号を接続)
              tr
                td SYNC IN
                td シンク入力

              tr
                td CV OUT
                td CV出力
              tr
                td GATE OUT
                td ゲート出力

              tr
                td PHONES
                td ヘッドフォンを接続する3.5 mmTRS出力音量



        +section3("ディストーション部")
          p ディストーションスイッチがオンの時のみ有効
          .tableScroll
            table
              tr
                td DRIVE
                td ディストーションの量を調節
              tr
                td TONE
                td トーンを調節
              tr
                td LEVEL
                td ディストーションの出力レベルを調節
              tr
                td TEMPO
                td パターン、トラックのテンポを調節
              tr
                td WAVEFORM
                td 内蔵VCOオシレーターの波形を逆三角波かパルス波のどちらに設定するか選択
              tr
                td TRACK/PATTERN GROUP
                td トラックの書き込み、プレイについて、トラック1～7から選択
                  br
                  | パターンの書き込み、プレイについては、パターングループI、II、IIIから選択
                  table
                    tr
                      td グループIのパターン
                      td トラック1か2のみ
                    tr
                      td グループIIのパターン
                      td トラック3か4
                    tr
                      td グループIIIのパターン
                      td トラック5か6
                    tr
                      td グループIV
                      td トラック7のみ
              tr
                td MODE
                td Track Write、Track Play、Pattern Play、Pattern Writeのいずれかを選択
              tr
                td 電源LED
                td 背面パネルの電源スイッチがオンで、ユニットに電源が供給されていると点灯
              tr
                td DISTORTION ON/OFF
                td
                  table
                    tr
                      td OFF
                      td ディストーションはバイパスされる
                        br
                        | DRIVE、TONE、LEVELコントロールのエフェクトはかからない
                    tr
                      td ON
                      td ディストーションが有効になる
              tr
                td VOLUME
                td 背面パネルの出力端子、ヘッドフォン出力の出力レベルを調節




        +section3("シーケンサー部")
          .tableScroll
            table
              tr
                td D.C./BAR RESET/CLEAR
                td メモリーからパターンをクリアする際、トラックの頭に戻る際に使用
                  br
                  | 最後のパターンをトラックに追加したことも示す
              tr
                td PITCH MODE
                td ピッチモードをオン／オフ
                  br
                  | ピッチモードではLEDが点灯
                  br
                  | パターン作成時にノートを入力するモード
              tr
                td キーボード
                td パターン作成時のノート選択に使用
                  br
                  | 下の8つのスイッチは、パターンおよびトラックの作成、保存、選択にも使用
              tr
                td TIME MODE LED
                td タイムモードの時にLEDが点灯
              tr
                td TIME MODE ON/OFF
                td タイムモードのオン／オフを選択
                  br
                  | タイムモードは、ピッチモードでノートを入力した後、タイミングの入力(ノート、タイ、レスト)に使用
              tr
                td BACK
                td パターンをステップスルーする際、最後にプレイしたノートを選択し、編集可能な状態にするボタン
                  br
                  | BACKボタンと WRITE/NEXTボタンは、シンク、クロック設定の確認、変更に使用
              tr
                td START / STOP
                td パターン、トラックの再生をスタート/ストップする
                  br
                  | プレイ中は LEDが点灯
              tr
                td FUNCTION
                td ピッチモード、タイムモードからノーマルモードへ戻す
                  br
                  | パターン、トラックの書き込み時に様々な操作をおこなう多目的スイッチ
              tr
                td NORMAL MODE
                td ユニットがノーマルモードの間点灯するLED
              tr
                td TRANSPOSE DOWN
                td ピッチモードではオクターブを下げる
                  br
                  | タイムモードではノートを入力
                  br
                  | パターンではステップ回数を入力
              tr
                td TRANSPOSE UP（トランスポーズ アップ）
                td ピッチモードではオクターブを上げる
                  br
                  | タイムモードではタイを入力
                  br
                  | パターンを三連符モードに設定
              tr
                td ACCENT / PATTERN A
                td ピッチモードでノートにアクセントをつけ、1A、2A～ 8A までの、Aパターンを選択
              tr
                td SLIDE / PATTERN B
                td ピッチモードで、ノートにスライドを付加し、1B、2B～ 8B までの、Bパターンを選択
              tr
                td D.S./WRITE/NEXT/TAP
                td トラックにパターンを書き込み、パターンの次のノートを選択し、タッピングにより手動でタイミングを付加
                  br
                  | D.S./WRITE/NEXT/TAPとBACKは、シンクおよびクロック設定の確認、変更に使用





      +section2("操作")
        +section3("シンク、クロックタイプの設定")




          table
            tr
              td セレクタースイッチ1
              td クロックソース INT(内部)を表す
                br
                | 外部クロックを使用しない場合は、必ずクロックソースをINT(内部)に設定する
            tr
              td セレクタースイッチ2
              td クロックソース MIDIを表す
            tr
              td セレクタースイッチ3
              td クロックソース USBを表す
            tr
              td セレクタースイッチ4
              td クロックソース TRIGを表す
            tr
              td セレクタースイッチ5
              td クロックレート 1PPsを表す
            tr
              td セレクタースイッチ6
              td クロックレート 2PPQを表す
            tr
              td セレクタースイッチ7
              td クロックレート 24PPQを表す(推奨)
            tr
              td セレクタースイッチ8
              td クロックレート 48PPQを表す(推奨)



          div.contentOperationBox
            p.contentOperationCaption 操作
              ul.contentOperationOrderlistGroup
                li.contentOperationOrderlist Functionを押す
                li.contentOperationOrderlist シーケンスがプレイ状態でないことを確認
                li.contentOperationOrderlist BACKとWRITE/NEXTを同時に押し、シンク設定モードに入る
                li.contentOperationOrderlist  セレクター 1 – 8 の LED が点灯し、現在のクロックソース(1 - 4)とクロックレート(5 - 8)が点滅する
                  br
                  | 必要に応じて、3 秒以内に変更を加える
                li.contentOperationOrderlist セレクター 1、2、3、4を押して、クロックソースを指定
                li.contentOperationOrderlist セレクター 5、6、7、8を押して、クロックレートを指定
                li.contentOperationOrderlist ボタンを押すか、または変更作業をせずに3秒間が過ぎると、保存される
                li.contentOperationOrderlist BACKとWRITE/NEXTを同時に押し、シンク設定モードに入って、実行した選択を確認する





        +section3("チューニング")


          div.contentOperationBox
            p.contentOperationCaption 操作
              ul.contentOperationOrderlistGroup
                li.contentOperationOrderlist VOLUMEが下がっていることを確認
                li.contentOperationOrderlist MODEスイッチを PATTERN PLAYにする
                li.contentOperationOrderlist PITCH MODEスイッチを長押しし、PATTERN 6スイッチを押す(ノートA)
                li.contentOperationOrderlist WRITE/NEXTを押すたびに、ヘッドフォンまたはスピーカーでこのノートが聞こえる
                li.contentOperationOrderlist VOLUMEレベルを調節し、快適なリスニングレベルに設定する
                li.contentOperationOrderlist TUNEコントロールを使用し、出力周波数を正確に220 Hzに設定
                  br
                  | (周波数は上下に調整可能)
                li.contentOperationOrderlist A の代わりに他のノートをチューニングする場合は、PITCH MODE を長押しし、任意のノートを押す
                li.contentOperationOrderlist シンセサイザーコントロールやディストーションで色々と試す






    include ../_include/_footer.pug

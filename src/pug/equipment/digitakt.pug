- var pagename='Digitakt|spindey.com'
- var description='ElektronのDigitaktのマニュアルです。'
- var keywords='Digitakt,Elektron'
doctype html
html(lang="ja")
  include ../_include/_head.pug
  body
    h1.heading Digitakt
    main
      h2.heading.switch
        | ユーザーインターフェース
        span.swithCondition.contentClosed
      section.h2content.hide
        h3.heading.switch
          | 画面の移動
          span.swithCondition.contentClosed
        section.h3content.hide
          table
            tr
              th [UP]、[DOWN]、[LEFT]、[RIGHT]の矢印キー
              td メニューやサブメニュー間を移動する
            tr
              th EVEL/DATA ノブ
              td メニューやリストを素早くスクロール
            tr
              th [YES]
              td 確認、選択、サブメニューの表示、ボックスのチェック/チェックを外す
            tr
              th [NO]
              td 無効化、選択解除、1つまたは複数の手順を進めたり戻ったり
        h3.heading.switch
          | パラメータ編集
          span.swithCondition.contentClosed
        section.h3content.hide
          p
            | DATA ENTRYノブは、トラックパラメータの値の変更に使用する
            br
            |                 DATA ENTRYノブを押しながら回すと、大きな単位でパラメータを調整できる
          table
            tr
              th パラメータをデフォルト値にリセット
              td DATA ENTRYノブと[NO]を押す
            tr
              th 選択したパラメータグループをデフォルト値にリセット
              td [PARAMETER]キーと[PLAY]を押す
            tr
              th パラメータの正確な値を表示
              td [PARAMETER]キーを押したままにする
            tr
              th ランダマイズ
              td [PARAMETER]+[YES]
            tr
              th PARAMETERページが最後に保存された状態にリセット
              td [PARAMETER]+[NO]
            tr
              th パラメータ値のジャンプ
              td
                | 特定のパラメータの編集中に、[FUNC]を押すと、パラメータ値が適切な位置にジャンプする
                br
                |                         例：ディレイ時間では、値の倍増や半減
                br
                |                         例：サンプルチューニングは、オクターブ全体分ジャンプ
            tr
              th パターン内のオーディオトラック内の同じパラメーターを一括変更
              td [TRK]を押したままにしてパラメータ設定を変更する
        h3.heading.switch
          | クイックスクロール
          span.swithCondition.contentClosed
        section.h3content.hide
          table
            tr
              th LEVEL/DATAノブ
              td メニューをスクロールする
            tr
              th [FUNC]キーと[UP]または [DOWN]キー
              td カーソルが 1つのメニューページ分移動
        h3.heading.switch
          | NAMING画面
          span.swithCondition.contentClosed
        section.h3content.hide
          p 名前付けの方法は、サンプル、サウンド、プロジェクトなどを保存する際の名前を付ける場合で共通
          table
            tr
              th 文字間を移動
              td [LEFT]と[RIGHT]矢印キー
            tr
              th 文字を順番に移動
              td LEVEL/DATAノブを回すか、[UP]または[DOWN]矢印キーを押す
            tr
              th 文字を消去
              td [FUNC]と[NO]を押す
            tr
              th スペースを挿入
              td [FUNC]と[YES] を押す
            tr
              th ポップアップメニューを表示
              td
                | [FUNC]を押したままにするとポップアップメニューが表示される
                br
                |                         [FUNC]を押したままにして 矢印キーを使用すると、挿入対象の文字がハイライトされる
                br
                |                         そこで、[FUNC] を放すと文字が追加される
      h2.heading.switch
        | プリセット
        span.swithCondition.contentClosed
      section.h2content.hide
        h3.heading.switch
          | 工場出荷時プリセットの再生
          span.swithCondition.contentClosed
        section.h3content.hide
          .contentOperationBox
            p.contentOperationCaption 操作
            ul.contentOperationOrderlistGroup
              li.contentOperationOrderlist
                | [BANK]と[TRIG 9]キーを押してバンクAを選択
                br
                |                         画面に「BANK A :SELECT PTN」と表示される
              li.contentOperationOrderlist [PTN]と[TRIG 1]キーを押してバンクAの最初のパターンを選択
              li.contentOperationOrderlist [PLAY]を押してパターンA01を再生
              li.contentOperationOrderlist
                | [PTN]と[TRIG 2]キーを押してパターンA02を選択
                br
                |                         パターンA01の最後まで来ると、再生が開始される
                br
                |                         [PTN]と[TRIG 3]を押してパターンA03を選択して同様に操作する
              li.contentOperationOrderlist 再生を停止するには[STOP]を押す
      h2.heading.switch
        | データ構成
        span.swithCondition.contentClosed
      section.h2content.hide
        h3.heading.switch
          | プロジェクト、パターン、キット、サウンド、サンプル
          span.swithCondition.contentClosed
        section.h3content.hide
          table
            tr
              th プロジェクト
              td
                | プロジェクトには、128個のパターンが含まれる
                br
                |                         全般設定と状態はプロジェクトに保存される
                br
                |                         プロジェクトはSETTINGSメニューで保存、ロード、管理する
                br
                |                         最大64MB(約11分間)のサンプルをロードできる
            tr
              th パターン
              td
                | パターンは主なデータコンテナー
                br
                |                         各バンクに16個のパターンを使用できる
                br
                |                         パターンには最大8個のサウンド(各オーディオトラックに1つずつ)と、トリガーやパラメータロックなどのシーケンサーデータを格納できる
                br
                |                         TRIGページの設定やBPM、長さ、スイング、拍子記号のデフォルト設定も含まれている
                br
                |                         パターンには、8つのMIDIトラックのすべてのパラメータ設定も含まれる
            tr
              th キット
              td
                | キットは8つのサウンドの集合
                br
            tr
              th サウンド
              td
                | サウンドは、8つのオーディオトラックのいずれかに割り当てることができる
                br
                |                         サウンドは、サンプルと、PARAMETERページのすべての設定(SRC、FLTR、AMP、LFO)を合わせたもの
                br
                |                         各オーディオトラックには1つのサウンドを含めることができる
                br
                |                         サウンドは+Driveサウンドライブラリに保存される
                br
                |                         SOUND MANAGERを使用して、サウンドを管理できる
                br
                |                         サウンドは、+Driveサウンドライブラリと、アクティブなプロジェクトのサウンドプールのどちらからもロードできる
                br
                br
                |                         +Driveからパターンにインポートしたサウンドはアクティブのパターンの一部になるので、サウンドを変更しても、保存されているサウンドやキットには影響しない
                br
                |                         アクティブなパターンのサウンドにのみ影響する
                br
                |                         アクティブなパターンから+Driveにサウンドをエクスポート(および保存)できる
                br
            tr
              th サンプル
              td
                | 最大127個のサンプルスロットを使用して、プロジェクトに64MB(約11分間)までサンプルをロードできる
                br
                |                         サンプルは+Driveサンプルバンクに保存される
                br
                |                         その他のサンプルは、Elektron転送ソフトウェアを使用して、コンピューターからDigitaktに転送できる
                br
                |                         また、Digitaktで直接サンプリングすることもできる
                br
                |                         サウンドやパターンで使用されているサンプルは、名前を変更したり移動したりしても、意図したとおりに動作する
                br
                |                         これは、ファイルごとに固有の値を追加するハッシュ関数を使用しているためで、この値は、ファイル名やデータ構造内のファイルの場所には依存しない
                br
                |                         ただし、サンプルを削除した場合は、サウンドやパターンには含まれなくなる
                br
                |                         +Driveからサンプルを削除した場合は、サウンドやパターンには含まれなくなる
                br
                |                         サンプルは、ロックするためにプロジェクトにインポートする必要がある
          table
            tr
              th パターンに含まれるもの
              td
                ul
                  li キット
                  li 8つのMIDIトラックのすべてのパラメータ設定
                  li トリガーやパラメータロックなどのシーケンサーデータ
                  li
                    | TRIG PARAMETERページの設定
                    br
                    |                                 BPM、長さ、スイング、拍子記号設定
                  li TRIGページのトリガーの全般設定(デフォルトノートピッチ、ベロシティなど)
                  li SRC、FLTR、AMP、LFOページのパラメータ設定
                  li DELAY、REVERB、MASTERページの設定
                  li クォンタイゼーション設定
                  li すべてのトラックのノート
                  li すべてのトラックのロックトリガー
                  li パラメータロック
                  li サンプルロック
                  li サウンドロック
                  li トラックの長さと拍子記号
            tr
              th キットに含まれるもの
              td
                ul
                  li 8つのオーディオトラックのサウンド
                  li オーディオトラックのLEVEL設定
            tr
              th サウンドに含まれるもの
              td
                ul
                  li +Driveからリンクされているサンプル、およびオーディオトラックのSRC、FLTR、AMP、LFO PARAMETERページ設定
            tr
              th サンプルに含まれるもの
              td
                ul
                  li 16ビット、48kHz、モノラルオーディオファイル
        h3.heading.switch
          | +Driveサウンドライブラリとサウンドプール
          span.swithCondition.contentClosed
        section.h3content.hide
          table
            tr
              th +Driveサウンドライブラリ
              td
                | +Driveは非揮発性ストレージ
                br
                |                         内部に最大128個のプロジェクトを保存できる
                br
                |                         +Driveには、サンプルバンクも搭載されているので、どのプロジェクトからもこれらのサンプルにアクセスできる
                br
                |                         +Driveの総容量は1GB
                br
                |                         +Driveサウンドライブラリには、最大2048個のサウンド(バンクA～Hそれぞれに256個のサウンド)を保存でき、すべてのプロジェクトで使用できる
                br
            tr
              th サウンドプール
              td
                | サウンドプールはプロジェクトの一部
                br
                |                         保存できるサウンドは128個
                br
                |                         サウンドプールにサウンドをロードすると、サウンドをロックすることができる
      h2.heading.switch
        | テンポ
        span.swithCondition.contentClosed
      section.h2content.hide
        h3.heading.switch
          | BPM設定を変更する
          span.swithCondition.contentClosed
        section.h3content.hide
          .contentOperationBox
            p.contentOperationCaption 操作
            ul.contentOperationOrderlistGroup
              li.contentOperationOrderlist [TEMPO]キーを押してTEMPOメニューを開く
              li.contentOperationOrderlist [FUNC]と[YES]を押すと、GLOBALテンポモードとPATTERNテンポモードが切り替わる
          table
            tr
              th テンポを変更する
              td EVEL/DATAノブを使用する
            tr
              th テンポを変更する(8BPMずつ)
              td ノブを押しながら回す
            tr
              th テンポを段階的に変化
              td 矢印キーの[UP]か[DOWN]
        h3.heading.switch
          | テンポの一時的変更(10%)
          span.swithCondition.contentClosed
        section.h3content.hide
          .contentOperationBox
            p.contentOperationCaption 操作
            ul.contentOperationOrderlistGroup
              li.contentOperationOrderlist メインインターフェイス画面で[LEFT]か[RIGHT]矢印キーを押したままにする
              li.contentOperationOrderlist 元のテンポに戻すにはキーを放す
        h3.heading.switch
          | タップテンポ
          span.swithCondition.contentClosed
        section.h3content.hide
          .contentOperationBox
            p.contentOperationCaption 操作
            ul.contentOperationOrderlistGroup
              li.contentOperationOrderlist [FUNCTION]キーを押したまま一定のリズムで[TEMPO]キーをタップする
              li.contentOperationOrderlist 4回連続してタップすると、タップの平均のテンポが計算される
              li.contentOperationOrderlist タップし続けると、平均テンポも更新される
        h3.heading.switch
          | テンポの微調整
          span.swithCondition.contentClosed
        section.h3content.hide
          p
            | テンポの微調整は、ターンテーブルや外部音源にDigitaktを手動で同期する場合に非常に便利
            br
            |                 テンポの微調整を実行する場合、TEMPOメニューにする必要はない
      h2.heading.switch
        | コピー&ペースト、クリア
        span.swithCondition.contentClosed
      section.h2content.hide
        h3.heading.switch
          | コピー&ペースト、クリア
          span.swithCondition.contentClosed
        section.h3content.hide
          p
            | パターン、トラック、トラックページやトリガーはコピー＆ペースト、クリアできる
          p
            | コピー用クリップボードに保持できるのは、一度に1つの項目のみ
            br
            |                 コピーコマンドを実行すると、以前にコピーされていた項目が新しくコピーされた項目に置き換わる
            br
            |                 例：トリガーとパターンを同時にコピーすることはできない
        h3.heading.switch
          | パラメーター
          span.swithCondition.contentClosed
        section.h3content.hide
          p ページごと
          table
            tr
              th コピー&ペースト
              td
                | [TRK]と[TRIG 1～16]でコピー元のトラックを選択
                br
                |                         [TRIG][SRC][FLTR][AMP][LFO]のどれかを押しながら[COPY]([FUNC]+[REC])を押してパラメータをコピー
                br
                |                         [TRK]と[TRIG 1～16]でコピー先のトラックに移動
                br
                |                         [TRIG][SRC][FLTR][AMP][LFO]のどれかを押しながら[Paste]を押してパラメータをペースト
            tr
              th クリア
              td
                | [TRK]と[TRIG 1～16]でトラックを選択
                br
                |                         [TRIG][SRC][FLTR][AMP][LFO]のどれかを押しながら[Clear]を押してクリア
          p まとめて(TRIGページは除く)
          table
            tr
              th コピー&ペースト
              td
                | [TRK]と[TRIG 1～16]でコピー元のトラックを選択
                br
                |                         [TRK]を押しながら[COPY]([FUNC]+[REC])を押してパラメータをコピー
                br
                |                         [TRK]と[TRIG 1～16]でコピー先のトラックに移動
                br
                |                         [TRK]を押しながら[Paste]を押してパラメータをペースト
            tr
              th クリア
              td
                | [TRK]と[TRIG 1～16]でトラックを選択
                br
                |                         [TRIG][SRC][FLTR][AMP][LFO]のどれかを押しながら[Clear]を押してクリア
        h3.heading.switch
          | トリガー
          span.swithCondition.contentClosed
        section.h3content.hide
          p
            | トリガーのコピー&ペースト、クリア(パラメータロック設定含む)
            br
            |                 GRID RECORDINGモード時のみ有効
            br
            |                 [TRIG][SRC][FLTR][AMP][LFO]ページのパラメーターすべてがコピー&ペースト、クリアされる
          table
            tr
              th トリガーのコピー&ペースト(複数パラメーターページ)
              td
                | コピーしたいトリガー(複数可)を押したまま[COPY]を押す
                br
                |                         ペーストしたい[TRIG]キーを押したまま[PASTE]を押す
            tr
              th トリガーのクリア
              td 1つまたは複数のトリガーを押したまま[CLEAR]を押す
        h3.heading.switch
          | ページ
          span.swithCondition.contentClosed
        section.h3content.hide
          p
            | GRID RECORDINGモードを有効にする必要がある
            br
            |                 ページを1ページだけコピー&ペースト、クリアする
            br
            |                 アクティブなトラックページだけが対象
          table
            tr
              th ページのコピー&ペースト(複数パラメーターページ)
              td
                | [PAGE]キーを押したまま[COPY]を押す
                br
                |                         ペーストしたい[PAGE]キーを押したまま[PASTE]を押す
            tr
              th トリガーのクリア
              td [PAGE]キーを押したまま[CLEAR]を押す
        h3.heading.switch
          | トラック
          span.swithCondition.contentClosed
        section.h3content.hide
          table
            tr
              th
                | トラックのコピー&ペースト
              td
                | [FUNC]キーを押したまま[COPY]を押す
                br
                |                         [FUNC]キーを押したまま[PASTE]を押す
            tr
              th トラックのクリア
              td [FUNC]キーを押したまま[CLEAR]を押す
        h3.heading.switch
          | パターン
          span.swithCondition.contentClosed
        section.h3content.hide
          p
            | アクティブなパターンは、同じバンクの別の場所、または別のバンクにコピーできる
          p
            | 実行するには、GRID RECORDINGモードを無効にする必要がある
          table
            tr
              th コピー&ペースト
              td
                | [FUNC]と[COPY]を押す
                br
                |                         別のパターンを選択して、[FUNC]と[PASTE]を押すと、この場所にコピーしたパターンが貼り付けられる
                br
                |                         現在アクティブなパターンにのみ貼り付けられる
            tr
              th クリア
              td [FUNC]と[PLAY]を押す
          p
            | ペーストとクリアは、このキーの組み合わせをもう一度押すと取り消し
        h3.heading.switch
          | 1つまたは複数のパターン
          span.swithCondition.contentClosed
        section.h3content.hide
          p 1つまたは複数のパターンを、アクティブなパターンを閉じずにコピー&ペースト、クリア
          table
            tr
              th パターンのコピー&ペースト
              td
                | [PTN]キーを押し、パターンの選択画面にする
                | コピーしたいパターンの[TRIG 1～16]キーを押しながら[COPY]キーを押す
                br
                |                         (COPY PATTERNと表示される)
                br
                |                         [PTN]キーを押し、パターンの選択画面にする
                br
                |                         ペーストしたい[TRIG 1～16]キー(複数可)を押しながら[PASTE]キーを押す
                br
                |                         4秒押しっぱなしにするとペーストされる
                br
                | (Pasted X pattern(s)と表示される)
            tr
              th パターンのクリア
              td
                | [PTN]キーを押し、パターンの選択画面にする
                br
                |                         クリアしたいパターンの[TRIG 1～16]キー(複数可)を押しながら[CLEAR]キーを押す
                br
                |                         4秒押しっぱなしにするとクリアされる
                br
                | (Cleared X pattern(s)と表示される)
        h3.heading.switch
          | サウンド
          span.swithCondition.contentClosed
        section.h3content.hide
          p
            | すべてのパラメータ設定とサンプルを別のトラックにコピーする
          .contentOperationBox
            p.contentOperationCaption 操作
            ul.contentOperationOrderlistGroup
              li.contentOperationOrderlist [TRK]と[COPY]を押す
              li.contentOperationOrderlist [TRK]と[TRIG 1～8]でトラックを選択
              li.contentOperationOrderlist [TRK]と[PASTE] を押す
      h2.heading.switch
        | パターンレコーディングモード
        span.swithCondition.contentClosed
      section.h2content.hide
        h3.heading.switch
          | パターンレコーディングモード
          span.swithCondition.contentClosed
        section.h3content.hide
          p
            | Digitaktには、パターンの作成時にトリガーの入力モードが2つある
            br
            |                 GRID RECORDINGモードとLIVE RECORDINGモード
            br
            |                 新しいパターンを作成するには、バンクのいずれかで空のパターンのスロットを選択する
        h3.heading.switch
          | GRID RECORDINGモード
          span.swithCondition.contentClosed
        section.h3content.hide
          p [TRIG]キーを使用してパターングリッドにトリガーを追加する
          .contentOperationBox
            p.contentOperationCaption 操作
            ul.contentOperationOrderlistGroup
              li.contentOperationOrderlist
                | [REC]キーを押して、GRID RECORDINGモードにする
                br
                |                         [REC]キーが赤に点灯し、GRID RECORDINGモードがアクティブであることを示す
              li.contentOperationOrderlist
                | トリガーを追加するトラックを、[TRACK]を押したままにしてから[TRIG]キーのいずれかを押して選択
                br
                |                         アクティブなトラックは[TRIG]キーが赤になる
              li.contentOperationOrderlist
                | 16個の[TRIG]キーを使用して、シーケンサーにノートトリガーを配置する
                br
                |                         ロックトリガーを追加するには、[FUNCTION]と[TRIG]を押す
                br
                |                         ロックトリガーは、ノートトリガーを含むものを含めたシーケンサーのステップで入力できる
                br
                |                         入力したトリガーの[TRIG]キーを素早く押すと、トリガーが削除される
                br
                |                         トリガーの[TRIG]キーを少し長く押し続けると、トリガーが削除されるのではなく、編集ができるようになる
              li.contentOperationOrderlist

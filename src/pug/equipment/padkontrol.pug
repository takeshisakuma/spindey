- var pagename='padKontrol|spindey.com'
- var description='KorgのpadKontrolのマニュアルです。'
- var keywords='padKontrol,Korg'
doctype html
html(lang="ja")
  include ../_include/_head.pug
  body
    h1.heading padKontrol
    main.equipmentMain




      h2.heading.switch
        | モード
        span.swithCondition.contentClosed
      section.h2content.hide
        h3.heading.switch
          | モード
          span.swithCondition.contentClosed
        section.h3content.hide
          table
            tr
              td play mode
              td ノートナンバーが割り当てられているパッドは消灯
                br
                | コントロールチェンジが割り当てられているパッドは点灯
            tr
              td setting mode
              td

        h3.heading.switch
          | モードの切り替え
          span.swithCondition.contentClosed
        section.h3content.hide


          div.contentOperationBox
            p.contentOperationCaption 操作
              ul.contentOperationOrderlistGroup
                li.contentOperationOrderlist 「setting」キーを押す


      h2.heading.switch
        | SCENE
        span.swithCondition.contentClosed
      section.h2content.hide
        h3.heading.switch
          | SCENE
          span.swithCondition.contentClosed
        section.h3content.hide
          p シーンは16個まで保存できる
          p 設定は保存をしないと電源オフや別のシーンに切り替えた時に消える
        h3.heading.switch
          | SCENEの呼び出し
          span.swithCondition.contentClosed
        section.h3content.hide
          p Playモード、settingモードどちらでも可能
          div.contentOperationBox
            p.contentOperationCaption 操作
              ul.contentOperationOrderlistGroup
                li.contentOperationOrderlist 「SCENEキー」を押したまま「PROG. CHANGE/WRITE/ALL PAD」キーを押す
                  br
                  | ディスプレイに保存先のシーンナンバーが点滅表示される
                li.contentOperationOrderlist 変更方法1:ダイヤルで変更
                  br
                  | 変更方法2:保存先を16パッドで選択
                li.contentOperationOrderlist 保存:「SETTING/ENTER」キー
                  br
                  | キャンセル:「MESSAGE/EXIT」キー


        h3.heading.switch
          | SCENEを保存
          span.swithCondition.contentClosed
        section.h3content.hide
          p Playモード、settingモードどちらでも可能
          p 設定は保存をしないと電源オフや別のシーンに切り替えた時に消える
          div.contentOperationBox
            p.contentOperationCaption 操作
              ul.contentOperationOrderlistGroup
                li.contentOperationOrderlist 「SCENE」キーを押したまま「PROG. CHANGE/WRITE/ALL PAD」キーを押す
                  br
                  | ディスプレイに保存先のシーンナンバーが点滅表示される
                li.contentOperationOrderlist 変更方法1:ダイヤルで変更
                  br
                  | 変更方法2:保存先を16パッドで選択
                li.contentOperationOrderlist 保存:「SETTING/ENTER」キー
                  br
                  | キャンセル:「MESSAGE/EXIT」キー



        h3.heading.switch
          | 工場出荷状態に戻す
          span.swithCondition.contentClosed
        section.h3content.hide
          p 30種類のプリロード・シーンが登録されていて、そのうち16個が読み込まれている
          p Playモード、settingモードどちらでも可能

          div.contentOperationBox
            p.contentOperationCaption 操作
              ul.contentOperationOrderlistGroup
                li.contentOperationOrderlist 「SCENE」キーを押したまま「FIXED VELOCITY/PRELOAD」キーを押す
                  br
                  | (「FIXED VELOCIT/PRELOAD」キーが点灯、「SETTING/ENTER」キーが点滅)
                  br
                  | ディスプレイにプリロード・シーン・ナンバーが表示される
                li.contentOperationOrderlist ダイヤルで(ALL)を選ぶ
                li.contentOperationOrderlist 実行:「SETTING/ENTER」キーを押す
                  br
                  | キャンセル:「MESSAGE/EXIT」キーを押す
                li.contentOperationOrderlist ディスプレイにLodと点滅表示され、ロードが行われる


        h3.heading.switch
          | プリロード・シーンを任意に読み込む
          span.swithCondition.contentClosed

        section.h3content.hide
          p 30種類のプリロード・シーンが登録されていて、そのうち16個が読み込まれている
          p Playモード、settingモードどちらでも可能
          div.contentOperationBox
            p.contentOperationCaption 操作
              ul.contentOperationOrderlistGroup
                li.contentOperationOrderlist 「SCENE」キーを押したまま「FIXED VELOCITY/PRELOAD」キーを押す(FIXED VELOCIT/PRELOADキーが点灯、SETTING/ENTERキーが点滅)
                  br
                  | ディスプレイにプリロード・シーン・ナンバーが表示される
                li.contentOperationOrderlist ダイヤルで(P.01～P.30)を選ぶ
                li.contentOperationOrderlist 「SETTING/ENTER」キーを押して読み込むプリロード・シーンを決定
                li.contentOperationOrderlist ダイヤルで保存先(S.01～S.16)を選ぶ
                li.contentOperationOrderlist 実行:「SETTING/ENTER」キーを押す
                  br
                  | キャンセル:「MESSAGE/EXIT」キーを押す




      h2.heading.switch
        | PLAY
        span.swithCondition.contentClosed
      section.h2content.hide

        h3.heading.switch
          |  フラムとロールを有効化する対象を決める
          span.swithCondition.contentClosed
        section.h3content.hide
          p playモード
            br
            | フラムとロールの有効化は個別にはできない

          div.contentOperationBox
            p.contentOperationCaption 操作
              ul.contentOperationOrderlistGroup
                li.contentOperationOrderlist 「FLAM」キーを押したまま16パッドか「PEDAL」キーを押す(点灯)
                  br
                  | または、「ROLL」キーを押したまま16パッドか「PEDAL」キーを押す(点灯)



        h3.heading.switch
          | ロール機能
          span.swithCondition.contentClosed
        section.h3content.hide
          p playモード


          div.contentOperationBox
            p.contentOperationCaption 操作
              ul.contentOperationOrderlistGroup
                li.contentOperationOrderlist 「ROLL」キーを押す(スピードに合わせて点滅)
                  br
                  | (フラムとロールの有効化は個別にはできない)
                li.contentOperationOrderlist X-Yパッドに触れながら16パッドかペダルを押す
                  br
                  | 16パッドやペダルを押している間はロール奏法(離すと止まる)


        h3.heading.switch
          | ロールスピードの設定
          span.swithCondition.contentClosed
        section.h3content.hide
          p playモード

          div.contentOperationBox
            p.contentOperationCaption 操作
              ul.contentOperationOrderlistGroup
                li.contentOperationOrderlist 「NOTE/CC#/LEFT」キーを押す(点灯)
                  br
                  | ディスプレイにはX-Yパッドの左端(最小値)を押したときの値が表示される
                li.contentOperationOrderlist ダイヤルでX-Yパッドの左端を押した時の値を決める(40-240)
                li.contentOperationOrderlist 「MIDI CH/RIGHT」キーを押す(点灯)
                  br
                  | ディスプレイにはX-Yパッドの右端(最大値)を押したときの値が表示される
                li.contentOperationOrderlist ダイヤルでX-Yパッドの右端を押した時の値を決める(40-240)
                li.contentOperationOrderlist 「SETTING/ENTER」キーを押す


        h3.heading.switch
          | ロールのVelocityの設定
          span.swithCondition.contentClosed
        section.h3content.hide
          p playモード

          div.contentOperationBox
            p.contentOperationCaption 操作
              ul.contentOperationOrderlistGroup
                li.contentOperationOrderlist 「REL. VAL/LOWE」キーを押す(点灯)
                  br
                  | ディスプレイにはX-Yパッドの下端(最小値)を押したときの値が表示される
                li.contentOperationOrderlist ダイヤルでX-Yパッドの下端を押した時の値を決める(1-127)
                li.contentOperationOrderlist 「VELOCITY/UPPER」キーを押す(点灯)
                  br
                  | ディスプレイにはX-Yパッドの上端(最大値)を押したときの値が表示される
                li.contentOperationOrderlist ダイヤルでX-Yパッドの上端を押した時の値を決める(1-127)
                li.contentOperationOrderlist 「SETTING/ENTER」キーを押す


        h3.heading.switch
          | フラム機能
          span.swithCondition.contentClosed
        section.h3content.hide
          p playモード
          p 16パッドかペダルのみ有効

          div.contentOperationBox
            p.contentOperationCaption 操作
              ul.contentOperationOrderlistGroup
                li.contentOperationOrderlist 「FRAM」キーを押す
                li.contentOperationOrderlist X-Yパッドに触れながらパッドやペダルを押す
                  br
                  | オフ：FLAMキーを押す(消灯)



        h3.heading.switch
          | フラムの1打目から2打目が発音されるまでの時間の設定
          span.swithCondition.contentClosed
        section.h3content.hide
          p playモード

          div.contentOperationBox
            p.contentOperationCaption 操作
              ul.contentOperationOrderlistGroup
                li.contentOperationOrderlist 「NOTE/CC#/LEFT」キーを押す(点灯)
                  br
                  | ディスプレイにはX-Yパッドの左端(最小値)を押したときの値が表示される
                li.contentOperationOrderlist ダイヤルでX-Yパッドの左端を押した時の値を決める(0-255)
                li.contentOperationOrderlist 「MIDI CH/RIGHT」キーを押す(点灯)
                  br
                  | ディスプレイにはX-Yパッドの右端(最大値)を押したときの値が表示される
                li.contentOperationOrderlist ダイヤルでX-Yパッドの右端を押した時の値を決める(0-255)
                li.contentOperationOrderlist 「SETTING/ENTER」キーを押す


        h3.heading.switch
          |  フラムの2打目のVelocityの設定
          span.swithCondition.contentClosed
        section.h3content.hide
          p playモード

          div.contentOperationBox
            p.contentOperationCaption 操作
              ul.contentOperationOrderlistGroup
                li.contentOperationOrderlist 「REL. VAL/LOWER」キーを押す(点灯)
                  br
                  | ディスプレイにはX-Yパッドの下端(最小値)を押したときの値が表示される
                li.contentOperationOrderlist ダイヤルでX-Yパッドの下端を押した時の値を決める(1-127)
                li.contentOperationOrderlist 「VELOCITY/UPPER」キーを押す(点灯)
                  br
                  | ディスプレイにはX-Yパッドの上端(最大値)を押したときの値が表示される
                li.contentOperationOrderlist ダイヤルでX-Yパッドの上端を押した時の値を決める(1-127)
                li.contentOperationOrderlist 「SETTING/ENTER」キーを押す





        h3.heading.switch
          | ホールド機能
          span.swithCondition.contentClosed
        section.h3content.hide
          p playモード

          div.contentOperationBox
            p.contentOperationCaption 操作
              ul.contentOperationOrderlistGroup
                li.contentOperationOrderlist 「HOLD」キーを押す(点灯)
                  br
                  | オフにするときは、「HOLD」キーを押す(消灯)

        h3.heading.switch
          | 固定Velocity機能
          span.swithCondition.contentClosed
        section.h3content.hide
          p playモード
            br
            | Velocityを強制的にSettingモードで設定した固定ベロシティ値にする

          div.contentOperationBox
            p.contentOperationCaption 操作
              ul.contentOperationOrderlistGroup
                li.contentOperationOrderlist 「FIXED VELOCITY/PRELOAD」キーを押す


        h3.heading.switch
          | 固定Velocityの設定
          span.swithCondition.contentClosed
        section.h3content.hide
          p ロール、フラム機能がオンの時、2打目以降のVelocityには効かない


          div.contentOperationBox
            p.contentOperationCaption 操作
              ul.contentOperationOrderlistGroup
                li.contentOperationOrderlist 「Setting」ボタンを押す(点灯)
                li.contentOperationOrderlist 「VELOCITY/UPPER」キーを押す(点灯)
                li.contentOperationOrderlist 「Fixed Velocity」キーを押す
                  br
                  | ディスプレイには固定ベロシティの値が点滅表示される
                li.contentOperationOrderlist ダイヤルを回して指定する(1～127)
                li.contentOperationOrderlist 「Setting」を押す
        h3.heading.switch
          | プログラムチェンジ送信
          span.swithCondition.contentClosed
        section.h3content.hide
          p playモード
          div.contentOperationBox
            p.contentOperationCaption 操作
              ul.contentOperationOrderlistGroup
                li.contentOperationOrderlist 「PROG CHANGE/WRITE/ALL PAD」キーを押しながらダイヤルを回す
                  br
                  | ディスプレイにはプログラムナンバーが点滅表示される
                li.contentOperationOrderlist 送信 「PROG CHANGE/WRITE/ALL PAD」キーを離す
                  br
                  | ※送信MIDIチャンネルがDisable以外の全16パッドやペダルで送信される

        h3.heading.switch
          | メッセージ送信
          span.swithCondition.contentClosed
        section.h3content.hide
          p playモード
          div.contentOperationBox
            p.contentOperationCaption 操作
              ul.contentOperationOrderlistGroup
                li.contentOperationOrderlist 送信：「MESSAGE/EXIT」キーを押しながら16パッドの1～3を押す
                  table
                    tr
                      td 1
                      td PANICの送信
                    tr
                      td 2
                      td NOTE OFFの送信
                    tr
                      td 3
                      td GM ONの送信
                    tr
                      td 4～8
                      td ユーザーが本来登録できるが、エディタ/ライブラリアンが最新OSで使えない

      h2.heading.switch
        | 16パッドの設定
        span.swithCondition.contentClosed
      section.h2content.hide
        h3.heading.switch
          | 16パッド
          span.swithCondition.contentClosed
        section.h3content.hide
          p 1つのパッドにはノートナンバーとコントロールチェンジのどちらかしか設定できない
        section.h3content.hide
        h3.heading.switch
          |  全ての16パッドを設定対象にする
          span.swithCondition.contentClosed
        section.h3content.hide

          div.contentOperationBox
            p.contentOperationCaption 操作
              ul.contentOperationOrderlistGroup
                li.contentOperationOrderlist 「Setting」ボタンを押す(点灯)
                li.contentOperationOrderlist 全選択:「PROG CHANGE/WRITE/ALL PAD」キーを押す(点灯)
                  br
                  | 解除：16パッドのどれかを押す


        h3.heading.switch
          |  16パッドにノート・ナンバーかコントロール・チェンジを割り当てる
          span.swithCondition.contentClosed
        section.h3content.hide

          div.contentOperationBox
            p.contentOperationCaption 操作
              ul.contentOperationOrderlistGroup
                li.contentOperationOrderlist 「Setting」ボタンを押す(点灯)
                li.contentOperationOrderlist 「NOTE/CC#/LEFT」キーを押す(点灯)
                li.contentOperationOrderlist 変えたい16パッドを押す(点灯)
                  table
                    tr
                      td ノートナンバーが割り当てられている時
                      td ディスプレイにノートナンバーが表示される
                    tr
                      td コントロール・チェンジが割り当てられている時
                      td ディスプレイにコントロール・チェンジ・ナンバーが表示される
                li.contentOperationOrderlist ジョグダイヤルで変更する(C-1～G9/C0～127)
                li.contentOperationOrderlist 次のパッドを押す(繰り返し)
                li.contentOperationOrderlist 「Setting」を押す


        h3.heading.switch
          | 16パッドのコントロール・チェンジのオン・バリューの設定
          span.swithCondition.contentClosed
        section.h3content.hide
          p コントロール・チェンジを紐づけているときは、オン・バリューの設定はできない(「VELOCITY/UPPER」キーを押しても「---」)
          div.contentOperationBox
            p.contentOperationCaption 操作
              ul.contentOperationOrderlistGroup
                li.contentOperationOrderlist 「Setting」ボタンを押す(点灯)
                li.contentOperationOrderlist 「VELOCITY/UPPER」キーを押す(点灯)
                  br
                  | ディスプレイには16パッドを押した時のオンバリュー(コントロールチェンジの値)が表示される
                li.contentOperationOrderlist 変えたい16パッドを押す(点灯)
                li.contentOperationOrderlist ジョグダイヤルで変更する(0～127)　
                li.contentOperationOrderlist 「Setting」を押す
        h3.heading.switch
          | 16パッドのコントロール・チェンジのリリース・バリューの設定
          span.swithCondition.contentClosed
        section.h3content.hide
          div.contentOperationBox
            p.contentOperationCaption 操作
              ul.contentOperationOrderlistGroup
                li.contentOperationOrderlist 「Setting」ボタンを押す(点灯)
                li.contentOperationOrderlist 「REL. VAL./LOWER」キーを押す(点灯)
                  br
                  | ディスプレイには16パッドを押した時のリリースバリュー(コントロールチェンジの値)が表示される
                li.contentOperationOrderlist ジョグダイヤルで変更する(0～127)　
                li.contentOperationOrderlist 「Setting」を押す

        h3.heading.switch
          | 16パッドのVelocity設定
          span.swithCondition.contentClosed
        section.h3content.hide
          p ノート・ナンバーを紐づけているときは、リリース・バリューの設定はできない(REL. VAL./LOWERキーを押しても「---」)

          div.contentOperationBox
            p.contentOperationCaption 操作
              ul.contentOperationOrderlistGroup
                li.contentOperationOrderlist 「Fixed Velocity」キーがオフなのを確認
                li.contentOperationOrderlist 「Setting」ボタンを押す(点灯)
                li.contentOperationOrderlist 「VELOCITY/UPPER」キーを押す(点灯)
                li.contentOperationOrderlist 設定したい16パッドを押す(点灯)
                li.contentOperationOrderlist ダイヤルを回して指定する(1～127/C-1～C-8)
                li.contentOperationOrderlist 「Setting」を押す

        h3.heading.switch
          | 16パッドのMIDI chの設定
          span.swithCondition.contentClosed
        section.h3content.hide
          div.contentOperationBox
            p.contentOperationCaption 操作
              ul.contentOperationOrderlistGroup
                li.contentOperationOrderlist 「Setting」ボタンを押す(点灯)
                li.contentOperationOrderlist 「MIDI ch」が点灯していることを確認
                li.contentOperationOrderlist 設定したい16パッドを押す(点灯)
                li.contentOperationOrderlist ジョグダイヤルで変更する(1～16/disable)
                li.contentOperationOrderlist 次のパッドを押す(繰り返し)
                li.contentOperationOrderlist 「Setting」を押す

        h3.heading.switch
          | 16パッドの動作タイプの設定
          span.swithCondition.contentClosed
        section.h3content.hide
          div.contentOperationBox
            p.contentOperationCaption 操作
              ul.contentOperationOrderlistGroup
                li.contentOperationOrderlist 「Setting」ボタンを押す(点灯)
                li.contentOperationOrderlist 「SW TYPE/POLARITY」キーを押す(点灯)
                  br
                  | ディスプレイに動作タイプが表示される
                li.contentOperationOrderlist 動作を設定したい16パッドを押す(点灯)
                li.contentOperationOrderlist ダイヤルで動作タイプを選ぶ(ooo/TGL)
                  table
                    tr
                      th ooo=Momentary
                      th 16パッドを押した時にノート・オン、離した時にノート・オフを送信
                    tr
                      th TGL=Momentary
                      th 16パッドを押した時にノート・オンとノート・オフを交互に送信
                li.contentOperationOrderlist 「Setting」を押す
        h3.heading.switch
          | 16パッドのUSB-MIDIポートの設定
          span.swithCondition.contentClosed
        section.h3content.hide

          div.contentOperationBox
            p.contentOperationCaption 操作
              ul.contentOperationOrderlistGroup
                li.contentOperationOrderlist 「Setting」ボタンを押す(点灯)
                li.contentOperationOrderlist 「PORT」キーを押す(点灯)
                li.contentOperationOrderlist ポートを設定したい16パッドを押す(点灯)
                  br
                  | ディスプレイには押した16パッドのポートが表示される
                li.contentOperationOrderlist ダイヤルでMIDI送信ポートを選択(P-A/-B)
                li.contentOperationOrderlist 「Setting」を押す

      h2.heading.switch
        | ペダルの設定
        span.swithCondition.contentClosed
      section.h2content.hide
        h3.heading.switch
          | ペダルにノート・メッセージかコントロール・チェンジを割り当てる
          span.swithCondition.contentClosed
        section.h3content.hide


          div.contentOperationBox
            p.contentOperationCaption 操作
              ul.contentOperationOrderlistGroup
                li.contentOperationOrderlist 「Setting」ボタンを押す(点灯)
                li.contentOperationOrderlist 「PEDAL」キーを押す(点灯)
                li.contentOperationOrderlist 「NOTE/CC#/LEFT」キーを押す(点灯)
                  table
                    tr
                      td ノートナンバーが割り当てられている時
                      td ディスプレイにノートナンバーが表示される
                    tr
                      td コントロール・チェンジが割り当てられている時
                      td ディスプレイにコントロール・チェンジ・ナンバーが表示される
                li.contentOperationOrderlist ジョグダイヤルで変更する(C-1～G9/0～127))　
                li.contentOperationOrderlist 「Setting」を押す


        h3.heading.switch
          | ペダルのMIDIチャンネルを設定する
          span.swithCondition.contentClosed
        section.h3content.hide

          div.contentOperationBox
            p.contentOperationCaption 操作
              ul.contentOperationOrderlistGroup
                li.contentOperationOrderlist 「Setting」ボタンを押す(点灯)
                li.contentOperationOrderlist 「PEDAL」キーを押す(点灯)
                li.contentOperationOrderlist 「MIDI CH/RIGHT」キーを押す(点灯)
                  br
                  | ディスプレイにはMIDIチャンネルが表示される
                li.contentOperationOrderlist ダイヤルでMIDIチャンネルを選択(1～16/Disable)
                li.contentOperationOrderlist 「Setting」を押す
        h3.heading.switch
          | ペダルの動作タイプの設定
          span.swithCondition.contentClosed
        section.h3content.hide

          div.contentOperationBox
            p.contentOperationCaption 操作
              ul.contentOperationOrderlistGroup
                li.contentOperationOrderlist 「Setting」ボタンを押す(点灯)
                li.contentOperationOrderlist 「PEDAL」キーを押す(点灯)
                li.contentOperationOrderlist 「SW TYPE/POLARITY」キーを押す(点灯)
                  br
                  | ディスプレイに動作タイプが表示される
                li.contentOperationOrderlist ダイヤルで動作タイプを選ぶ(ooo/TGL)
                  table
                    tr
                      th ooo=Momentary
                      th ペダルを押した時にノート・オン、離した時にノート・オフを送信
                    tr
                      th TGL=Momentary

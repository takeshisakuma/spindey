              td (#92)
            tr
              td LEVELスライダー
              td コントロール・チェンジ
              td (#93)
            tr
              td FX DEPTHノブ
              td コントロール・チェンジ
              td (#94)
            tr
              td HOLDキー
              td コントロール・チェンジ
              td (#95)
            tr
              td SAMPLE BANK Aキー
              td ノートon/off
              td a(#36)
            tr
              td SAMPLE BANK Bキー
              td ノートon/off
              td (#37)
            tr
              td SAMPLE BANK Cキー
              td ノートon/off
              td (#38)
            tr
              td SAMPLE BANK Dキー
              td ノートon/off
              td (#39)
            tr
              td PROGRAM/BPMノブ
              td プログラム・チェンジ
                br

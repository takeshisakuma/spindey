                p SAMPLE BANKキーはノート・ナンバーを設定する
                table
                  tr
                    td GLCH
                    td Global Channel
                  tr
                    td SAMPA～D
                    td Sample Bankeキー
                  tr
                    td PAD X、PAD Y、PAD T
                    td Pad Touch
                  tr
                    td FX.DP
                    td FX Depth
                  tr
                    td SLDR
                    td Slider
                  tr
                    td HOLD
                    td HOLDキー
            tr
              td [6] PAD LED
              td
                table
                  tr
                    td Prog

- var pagename='KAOSS DJ|spindey.com'
- var description='KORGのKAOSS DJのマニュアルです。'
- var keywords='KAOSS DJ,KORG'
doctype html
html(lang="ja")
  include ../_include/_head.pug
  body
    h1.heading KAOSS DJ
    main.equipmentMain
      h2.heading.switch
        | トラックの再生
        span.swithCondition.contentClosed
      section.h2content.hide
        h3.heading.switch
          | トラックに曲をロードして再生する
          span.swithCondition.contentClosed
        section.h3content.hide

          div.contentOperationBox
            p.contentOperationCaption 操作
              ul.contentOperationOrderlistGroup
                li.contentOperationOrderlist Browseノブを回してファイルを選択
                  br
                  | (フォルダの階層変更：Shiftボタンを押しながらBrowseノブを回す)
                li.contentOperationOrderlist 「Load Aボタン」または「Load Bボタン」でトラックを各デッキにロード
                li.contentOperationOrderlist 「Playボタン」でトラックを再生

      h2.heading.switch
        | MIX
        span.swithCondition.contentClosed
      section.h2content.hide
        h3.heading.switch
          | 音声を出力する
          span.swithCondition.contentClosed
        section.h3content.hide
          p 2つのデッキの音量を調節してミックスする

          table
            tr
              td 各デッキから出力される音声レベルを調整
              td Gainノブ、レベル・フェーダー
            tr
              td 音声を出力するデッキを切り替える
              td クロス・フェーダー
            tr
              td スピーカーの音声レベルを調整
              td Masterノブ

        h3.heading.switch
          | モニター出力を調節する
          span.swithCondition.contentClosed
        section.h3content.hide
          table
            tr
              td A、Bデッキそれぞれのモニター出力をオン/オフ切り替え
              td ヘッドホン・キュー・ボタン
            tr
              td ヘッドホン端子へのマスター・アウト・レベルとモニター・アウト・レベルの出力バランスを調節
              td モニターBalanceノブ
            tr
              td ヘッドホンの音量を調節
              td Headphoneノブ

        h3.heading.switch
          | レベル・メーターに表示するレベルを切り替える
          span.swithCondition.contentClosed
        section.h3content.hide
          div.contentOperationBox
            p.contentOperationCaption 操作
              ul.contentOperationOrderlistGroup
                li.contentOperationOrderlist Shiftボタンを押しながら、ヘッドホン・キュー・ボタンを押す



      h2.heading.switch
        | 曲のBPM
        span.swithCondition.contentClosed
      section.h2content.hide
        h3.heading.switch
          | Key Lock機能
          span.swithCondition.contentClosed
        section.h3content.hide
          p テンポを変えても音程が変わらなくする
          div.contentOperationBox
            p.contentOperationCaption 操作
              ul.contentOperationOrderlistGroup
                li.contentOperationOrderlist Shiftボタンを押しながらPlayボタンを押してKey LockのOn/Offを切り替える

        h3.heading.switch
          | 2つのデッキのBPMを自動的に合わせる
          span.swithCondition.contentClosed
        section.h3content.hide
          p Sync機能を使ってテンポを合わせる
          div.contentOperationBox
            p.contentOperationCaption 操作
              ul.contentOperationOrderlistGroup
                li.contentOperationOrderlist Syncボタンを押して、2つのデッキの再生速度と拍を合わせる


        h3.heading.switch
          | BPMを大きく変化させる
          span.swithCondition.contentClosed
        section.h3content.hide
          div.contentOperationBox
            p.contentOperationCaption 操作
              ul.contentOperationOrderlistGroup
                li.contentOperationOrderlist ピッチ・フェーダーでAまたはBのデッキの再生速度をもう一方のデッキに合わせる
          table
            tr
              th フェーダーを上げる
              td 再生速度が遅くなる
            tr
              th フェーダーを下げる
              td 再生速度が速くなる



        h3.heading.switch
          | BPMを微調整
          span.swithCondition.contentClosed
        section.h3content.hide
          p 2つのデッキの拍がずれているときは、タッチ・ホイールまたはタッチ・スライダーを使って拍のズレを修正
          div.contentOperationBox
            p.contentOperationCaption 操作
              ul.contentOperationOrderlistGroup
                li.contentOperationOrderlist タッチ・スライダー・モード・ボタンを押して、タッチ・スライダーをノーマル・モードに設定
                li.contentOperationOrderlist タッチ・スライダーの中央を押して、タッチ・ホイールのスクラッチ・モードをオフにする

          p タッチ・ホイール
          table
            tr
              th 左回り
              td 再生速度が減速
            tr
              th 右回り
              td 再生速度が加速
          p タッチ・スライダー
          table
            tr
              th 左
              td 遅くなる
            tr
              th 中央
              td スクラッチOn/Oﬀの切り替え
            tr
              th 右
              td 速くなる
            tr
              th タッチ・スライダー・モード・ボタン(無印のボタン)
              td LED を消灯させるとノーマル・モード

      h2.heading.switch
        | スクラッチ、サーチ
        span.swithCondition.contentClosed
      section.h2content.hide
        h3.heading.switch
          | スクラッチ、サーチ
          span.swithCondition.contentClosed
        section.h3content.hide
          div.contentOperationBox
            p.contentOperationCaption 操作
              ul.contentOperationOrderlistGroup
                li.contentOperationOrderlist タッチ・スライダー・モード・ボタンを押して、タッチ・スライダーをノーマル・モードに設定
                li.contentOperationOrderlist タッチ・スライダーのセンターを押して、タッチ・ホイールのスクラッチ・モードをオンにする
                li.contentOperationOrderlist タッチ・ホイールで再生位置を調整(スクラッチ)
                  br
                  | Shiftボタンを押しながら、タッチ・ホイールに触れると、触れる位置で再生位置を大きく調整可能
          table
            tr
              th 左回り
              td 再生位置を戻す
            tr
              th 右回り
              td 再生位置をすすめる

        h3.heading.switch
          | 曲の指定位置に移動
          span.swithCondition.contentClosed
        section.h3content.hide

          div.contentOperationBox
            p.contentOperationCaption 操作
              ul.contentOperationOrderlistGroup
                li.contentOperationOrderlist タッチ・スライダー・モードをノーマル・モードにする
                li.contentOperationOrderlist Shiftボタンを押しながらタッチ・スライダーに触れる
                  br
                  | (タッチ・スライダーの長さがロードされている曲の全体の長さに対応)


      h2.heading.switch
        | CUE
        span.swithCondition.contentClosed
      section.h2content.hide
        h3.heading.switch
          | CUE
          span.swithCondition.contentClosed
        section.h3content.hide
          p 頭出ししたい位置をあらかじめ設定しておき、呼び出してその位置から再生する

          div.contentOperationBox
            p.contentOperationCaption 操作
              ul.contentOperationOrderlistGroup
                li.contentOperationOrderlist 曲の頭出しをしたいところで一時停止し、Cueボタンを押すと、一時停止している位置にキュー・ポイントが設定される
                li.contentOperationOrderlist 再生中にCueボタンを押し、そのまま押し続けるとと、キュー・ポイントに戻った後、キュー・ポイントから再生
                li.contentOperationOrderlist Cueボタンを押すのをやめると、キュー・ポイントに戻り、停止
                  br
                  | Shiftボタンを押しながらCueボタンを押すと曲の先頭から再生

        h3.heading.switch
          | Hot.Cue
          span.swithCondition.contentClosed
        section.h3content.hide
          p Hot Cueは1トラックにつき3か所まで設定できる
            br
            | Hot Cueを設定した位置から瞬時に再生


          div.contentOperationBox
            p.contentOperationCaption 操作
              ul.contentOperationOrderlistGroup
                li.contentOperationOrderlist タッチ・スライダー・モード・ボタンを押しHot Cue LEDを点灯させて、タッチ・スライダーをHot Cueモードにする

          p Hot Cueモード時の操作
          table
            tr
              th Hot Cueを設定
              td 再生中または一時停止中にタッチ・スライダーの右、左または中央を押す
            tr
              th Hot Cueポイントから再生
              td Hot Cueを設定したタッチ・スライダーの右、左または中央を押す
            tr
              th Hot Cueポイントを消去
              td Shiftボタンを押しながらタッチ・スライダーの右、左または中央を押す




          p タッチ・スライダー
          table
            tr
              th 左
              td Hot Cue 1
            tr
              th 中央
              td Hot Cue 2
            tr
              th 右
              td Hot Cue 3
            tr
              th タッチ・スライダー・モード・ボタン(無印のボタン)
              td LEDを点灯させてタッチ・スライダーをHot Cueモードにする





      h2.heading.switch
        | LOOPを使う
        span.swithCondition.contentClosed
      section.h2content.hide
        h3.heading.switch
          | オート・ループ
          span.swithCondition.contentClosed
        section.h3content.hide
          p 曲のビートに合わせて最適なループを作成
          div.contentOperationBox
            p.contentOperationCaption 操作
              ul.contentOperationOrderlistGroup
                li.contentOperationOrderlist タッチ・スライダー・モード・ボタンを押してLoop LEDを点灯させて、タッチ・スライダーをLoopモードにする


          p タッチ・スライダー
          table
            tr
              th 左
              td 再生の長さを短く
            tr
              th 中央
              td ループ再生を開始、停止
            tr
              th 右
              td 再生の長さを長く
            tr
              th タッチ・スライダー・モード・ボタン(無印のボタン)
              td LEDを点灯させてタッチ・スライダーをLoopモードにする







        h3.heading.switch
          | マニュアル・ループ
          span.swithCondition.contentClosed
        section.h3content.hide
          p タッチ・スライダーを使って、自由にループを設定
          div.contentOperationBox
            p.contentOperationCaption 操作
              ul.contentOperationOrderlistGroup
                li.contentOperationOrderlist タッチ・スライダー・モード・ボタンを押してLoop LEDを点灯させて、タッチ・スライダーを Loopモードにする
                li.contentOperationOrderlist 再生中にShiftボタンを押しながらタッチ・スライダーの左を押してLoop Inポイントを設定
                li.contentOperationOrderlist Shiftボタンを押しながらタッチ・スライダーの右を押してLoop Outポイントを設定
                  br
                  | Loop InとLoop Outのポイントが設定されると、2つのポイント間を繰り返し再生
                li.contentOperationOrderlist ループ再生中にタッチ・スライダーの中央を押すと、ループ再生が終了

          p ループ再生中にShiftボタンを押しながらタッチ・スライダーの左または右を押すと、画面がLoop InポイントまたはOutポイントに移動
            br
            | このとき、タッチ・ホイールで各ポイントの位置を微調整することができる





      h2.heading.switch
        | エフェクト
        span.swithCondition.contentClosed
      section.h2content.hide
        h3.heading.switch
          | Serato DJのエフェクト
          span.swithCondition.contentClosed
        section.h3content.hide
          p タッチ・パッドでSerato DJのエフェクトをコントロール
          div.contentOperationBox
            p.contentOperationCaption 操作
              ul.contentOperationOrderlistGroup
                li.contentOperationOrderlist タッチ・パッド・モード・ボタンを押してController LEDを点灯させて、タッチ・パッドをコントローラー・モードにする
                li.contentOperationOrderlist Fxボタンでエフェクトをかけるデッキを選択
                li.contentOperationOrderlist AデッキまたはBデッキのShiftボタンを押しながら、プログラム/バリュー・ノブを回して、それぞれのデッキのエフェクトの種類を選ぶ
                li.contentOperationOrderlist タッチ・パッドでエフェクトをコントロールすることができる
          p TIP Holdボタンを押しながらタッチ・パッドにタッチすると、指を離してもエフェクトはオンのままになる
            br
            | もう一度Holdボタンを押すとホールドは解除



        h3.heading.switch
          | KAOSS DJのエフェクト
          span.swithCondition.contentClosed
        section.h3content.hide
          p KAOSS DJのエフェクトを、A、Bデッキをミックスした後にかけるマスター・エフェクトとして使う
          div.contentOperationBox
            p.contentOperationCaption 操作
              ul.contentOperationOrderlistGroup
                li.contentOperationOrderlist カオス・エフェクトのオン、オフ、タッチ・パッド・モード・ボタンを押してKaoss Fx LEDを点灯させて、タッチ・パッドをKaoss Fxモードにする
                  br
                  | Kaoss Fxモードでは、マスター・アウトにのみ、エフェクトのオン/オフが適用される
                  br
                  | AデッキとBデッキそれぞれ別々のエフェクト・プログラムを選ぶことはできない
                li.contentOperationOrderlist プログラム/バリュー・ノブを回して、使用するエフェクト・プログラムを選択
                li.contentOperationOrderlist タッチ・パッドに触れるとエフェクトがかかる
                li.contentOperationOrderlist タッチ・パッドから指を離すとエフェクトの効果が無くなる
          p Holdボタンを押してオンにすると、指を離す直前のエフェクトの効果が保持される
          p エフェクトのかかり具合(FX DEPTH)を調整する
          div.contentOperationBox
            p.contentOperationCaption 操作
              ul.contentOperationOrderlistGroup
                li.contentOperationOrderlist Shiftボタンを押しながらタッチ・パッドに触れ、指を左右に動かす


      h2.heading.switch
        | エフェクトのBPM
        span.swithCondition.contentClosed
      section.h2content.hide
        h3.heading.switch
          | エフェクトのBPMを設定する
          span.swithCondition.contentClosed
        section.h3content.hide
          p ディレイなどのプログラムで使用されるテンポを設定
          div.contentOperationBox
            p.contentOperationCaption 操作
              ul.contentOperationOrderlistGroup
                li.contentOperationOrderlist Tapボタンを押して、BPMを表示する
                li.contentOperationOrderlist プログラム/バリュー・ノブで値を変更することができる


        h3.heading.switch
          | タップ・テンポ
          span.swithCondition.contentClosed
        section.h3content.hide
          div.contentOperationBox
            p.contentOperationCaption 操作
              ul.contentOperationOrderlistGroup
                li.contentOperationOrderlist Tapボタンを押してディスプレイにBPMを表示した状態でTapボタンを数回叩くと、叩いた間隔でBPM値が設定される


        h3.heading.switch
          | オートBPM
          span.swithCondition.contentClosed
        section.h3content.hide
          p オートBPM 曲のビートを自動検出し、BPM値を設定することができる
          div.contentOperationBox
            p.contentOperationCaption 操作
              ul.contentOperationOrderlistGroup
                li.contentOperationOrderlist ビートを検出するデッキのFxボタンを押してデッキを選択
                li.contentOperationOrderlist 曲を再生している状態でTapボタンを長押す
                  br
                  | 再生している曲のビートを検出し、BPMが変化する
                li.contentOperationOrderlist オートBPMを終了するときは、再度、Tapボタンを長押しする
                  br
                  | 終了した時点のBPM値に設定される
          p BPMが検出できないときは、Tapボタンを数回曲のビートに合わせて押すと、そのビートをガイドとしてBPMを自動検出する
            br
            | オートBPMの特性上、正しいBPM値の1/2や2/3といった値や、細かな揺れが起こってしまうため、Tapボタンを使って補助を行うことができる
          p ビート感がはっきりしない音楽の場合は、BPM値を検出できない
            br
            | 検出可能なBPMは 80～160
          p 音声入力が無いときなどBPM検出ができない場合、オートBPM機能が終了しないままプログラム選択画面に戻る
            br
            | 再度、BPM表示を行いたい場合は、Tapボタンを押す










      h2.heading.switch
        | スケール、キー
        span.swithCondition.contentClosed
      section.h2content.hide
        h3.heading.switch
          | スケール(音階)を設定する
          span.swithCondition.contentClosed
        section.h3content.hide
          p シンセ・プログラムなどで タッチ・パッドを使って演奏するときに割りあてるスケール(音階)を設定

          div.contentOperationBox
            p.contentOperationCaption 操作
              ul.contentOperationOrderlistGroup
                li.contentOperationOrderlist Shiftボタンを押しながらHoldボタンを押すと、現在設定しているスケールの略称名がディスプレイに表示される
                li.contentOperationOrderlist プログラム/バリュー・ノブを回して、スケールを変える
                li.contentOperationOrderlist 変更後、一定時間経過するとプログラム表示に戻る
            p Shiftボタンを押すことで、すぐに プログラム表示に戻ることができる






        h3.heading.switch
          | キー(主音)を設定する
          span.swithCondition.contentClosed
        section.h3content.hide
          p シンセ・プログラムなどで使うスケールの基準となる音の高さを設定する

          div.contentOperationBox
            p.contentOperationCaption 操作
              ul.contentOperationOrderlistGroup
                li.contentOperationOrderlist Shiftボタンを押しながらTapボタンを押すと、現在設定されているキーがディスプレイに表示される
                li.contentOperationOrderlist プログラム/バリュー・ノブを回して、キーを変える
                li.contentOperationOrderlist 変更後、一定時間経過するとプログラム表示に戻る
          p Shiftボタンを押すことで、すぐに プログラム表示に戻ることができる
            br
            | 設定によっては、発音しなかったり、ノイズが出る場合がある





      h2.heading.switch
        | EQ
        span.swithCondition.contentClosed
      section.h2content.hide
        h3.heading.switch
          | EQを使う
          span.swithCondition.contentClosed
        section.h3content.hide
          p 各デッキの音質を調整
          table
            tr
              th EQ Hiノブ
              td 高音域の音量を調節
            tr
              th EQ Midノブ
              td 中音域の音量を調節
            tr
              th EQ Loノブ
              td 低音域の音量を調節











      h2.heading.switch
        | サンプラー
        span.swithCondition.contentClosed
      section.h2content.hide
        h3.heading.switch
          | サンプラー
          span.swithCondition.contentClosed
        section.h3content.hide
          p タッチ・パッドでSerato DJのサンプラーをコントロール

          div.contentOperationBox
            p.contentOperationCaption 操作
              ul.contentOperationOrderlistGroup
                li.contentOperationOrderlist タッチ・パッド・モード・ボタンを長押ししてController LEDを青色に点灯させて、タッチ・パッドをサンプラー・モードに切り替える
                li.contentOperationOrderlist タッチ・パッドをタップしてサンプラーを再生

          table
            tr
              th エフェクト1
              td タッチパッドの左上の領域
            tr
              th エフェクト2
              td タッチパッドの右上の領域
            tr
              th エフェクト3
              td タッチパッドの左下の領域
            tr
              th エフェクト4
              td タッチパッドの右下の領域

          p サンプラーへのオーディオ・データのアサインや録音は、Serato DJを操作する必要がある




      h2.heading.switch
        | 起動モード
        span.swithCondition.contentClosed
      section.h2content.hide
        h3.heading.switch
          | オーディオレス・モード
          span.swithCondition.contentClosed
        section.h3content.hide
          p 外部オーディオ・インターフェイスを使用したいとき
          div.contentOperationBox
            p.contentOperationCaption 操作
              ul.contentOperationOrderlistGroup
                li.contentOperationOrderlist タッチ・スライダー・モード・ボタン(Bデッキ)とヘッドホン・キュー・ボタン(Bデッキ)を押しながら、USBケーブルを差して起動

          p KAOSS DJのオーディオ・インターフェイス機能は使用できない
            br
            | KAOSS DJのOut L/Rから音は出力されない
          p すべてのコントローラーからMIDIメッセージを出力





        h3.heading.switch
          | オーディオ・リターン・モード
          span.swithCondition.contentClosed
        section.h3content.hide
          p ミックス後のアウトプット音声を録音したいとき
          div.contentOperationBox
            p.contentOperationCaption 操作
              ul.contentOperationOrderlistGroup
                li.contentOperationOrderlist タッチ・スライダー・モードボタン(Bデッキ)とFXボタン(Bデッキ)を押しながら、USBケーブ ルを差して起動

          p Out L/R端子へ出力される音声と同じ信号をコンピューター側へ返す
          p 通常時はMic/Line In Aの音声を返す





      h2.heading.switch
        | MIIDメッセージ一覧
        span.swithCondition.contentClosed
      section.h2content.hide
        h3.heading.switch
          | MIIDメッセージ一覧
          span.swithCondition.contentClosed
        section.h3content.hide
          div.tableScroll
            table
              tr
                th コントローラー
                th Number
                th MIDI Channel(Deck-A)
                th MIDI Channel(Deck-B)
                th LED
              tr
                td ヘッドフォンノブ(オーディオレス・モード時)
                td CC20
                td 7
                td 7
                td ○
              tr
                td Balanceブ(オーディオレス・モード時)
                td CC21
                td 7
                td 7
                td ○
              tr
                td Masterノブ(オーディオレス・モード時)
                td CC22
                td 7
                td 7
                td ○
              tr
                td Browseノブ
                td CC30
                td 7
                td 7

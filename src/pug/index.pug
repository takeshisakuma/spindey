- var pagename='spindey.com'
- var description='DTM機材のマニュアルサイトです。'
- var keywords='機材,マニュアル'

doctype html
html(lang="ja")
  include _include/_head.pug
  body
    header.topHeader
      a(href="/")
        h1
          img(src="/img/logo/spindey.svg")
    main.topMain
      .topContainer
        p.top__introduce
          | このサイトは、DTM機材の添付マニュアルが自分にとって分かりにくかったため、自分用に作成したマニュアルサイトです。
          br
          | ご覧になる場合は、機材を片手にスマホで見やすいよう最適化しておりますので、スマホでの閲覧をおすすめ致します。
        ul.top__categoryGroup
          li.top__categoryMember
            p.top__categoty__heading sampler & groovebox
            ul.top__equipmentGroup
              a(href="/equipment/electribe2sampler.html").top__equipmentlink
                li.top__equipmentMember
                  div.top__equipmentPicture
                    img(src="/img/photo/e2s.jpg")
                  p.top__equipmentName electrive 2 sampler
              a(href="/equipment/digitakt.html").top__equipmentlink
                li.top__equipmentMember
                  div.top__equipmentPicture
                    img(src="/img/photo/digitakt.jpg")
                  p.top__equipmentName digitakt
              a(href="/equipment/circuit.html").top__equipmentlink
                li.top__equipmentMember
                  div.top__equipmentPicture
                    img(src="/img/photo/circuit.jpg")
                  p.top__equipmentName circuit
              a(href="/equipment/mpclive.html").top__equipmentlink.nolink
                li.top__equipmentMember
                  div.top__equipmentPicture
                    img(src="/img/photo/nowmaking.svg")
                  p.top__equipmentName MPC live
          li.top__categoryMember
            p.top__categoty__heading synthesizer
            ul.top__equipmentGroup
              a(href="/equipment/circuitmonostation.html").top__equipmentlink
                li.top__equipmentMember
                  div.top__equipmentPicture
                    img(src="/img/photo/circuitmonostation.jpg")
                  p.top__equipmentName Circuit monostation
              a(href="/equipment/blofeld.html").top__equipmentlink
                li.top__equipmentMember
                  div.top__equipmentPicture
                    img(src="/img/photo/blofeld.jpg")
                  p.top__equipmentName blofeld
              a(href="/equipment/micron.html").top__equipmentlink
                li.top__equipmentMember
                  div.top__equipmentPicture
                    img(src="/img/photo/micron.jpg").top__equipmentPicture
                  p.top__equipmentName micron
          li.top__categoryMember
            p.top__categoty__heading rythm machine
            ul.top__equipmentGroup
              a(href="/equipment/xr20.html").top__equipmentlink
                li.top__equipmentMember
                  div.top__equipmentPicture
                    img(src="/img/photo/xr20.jpg")
                  p.top__equipmentName XR20
              a(href="/equipment/drumbrute.html").top__equipmentlink
                li.top__equipmentMember
                  div.top__equipmentPicture
                    img(src="/img/photo/drumbrute.jpg")
                  p.top__equipmentName drum brute
          li.top__categoryMember
            p.top__categoty__heading midi controller
            ul.top__equipmentGroup
              a(href="/equipment/twitch.html").top__equipmentlink
                li.top__equipmentMember
                  div.top__equipmentPicture
                    img(src="/img/photo/twitch.jpg")
                  p.top__equipmentName twitch
              a(href="/equipment/keystep.html").top__equipmentlink.nolink
                li.top__equipmentMember
                  div.top__equipmentPicture
                    img(src="/img/photo/nowmaking.svg")
                  p.top__equipmentName keystep
              a(href="/equipment/beatstep.html").top__equipmentlink.nolink
                li.top__equipmentMember
                  div.top__equipmentPicture
                    img(src="/img/photo/nowmaking.svg")
                  p.top__equipmentName beatstep
    include _include/_footer.pug
